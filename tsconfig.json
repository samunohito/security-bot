{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "tests", "scripts", "vitest.config.ts", "drizzle.config.ts"]
}
